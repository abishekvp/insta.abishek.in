# ==============================================================================
# InstaVault Pro - Production Environment Configuration
# All values below are strictly required in production mode (no default fallbacks).
# Product configurations (TTL, retention limits, crawler frequencies, etc.)
# are dynamically managed by administrators via the Admin Portal.
# ==============================================================================

# Server Network Port
PORT=5500

# Database File Path or URL (all media, stories, and data are stored directly in DB)
DATABASE_URL="./instavault.db"

# Master Cryptographic Secret Key (Used for AES-256-GCM encryption & HMAC tokens)
# MUST be at least 32 characters long
APP_SECRET="prod-instavault-enterprise-master-cryptographic-key-64ch-sec"

# ==============================================================================
# OPTION 1 — Official Instagram OAuth (Instagram API with Instagram Login)
# ------------------------------------------------------------------------------
# The recommended "Connect Instagram" flow. The user approves on Instagram's own
# consent screen and we receive a proper access token — no password, no cookie.
# These are OPTIONAL: leave them blank and the app still runs; the "Official Login"
# tab will just show as "not configured" until all three are set.
#
# Setup:
#   1. Create an app at https://developers.facebook.com/apps
#   2. Add the "Instagram" product and configure Instagram Login.
#   3. Copy the app's client id & secret below.
#   4. Whitelist the redirect URI (IG_OAUTH_REDIRECT_URI) in the app settings.
# ==============================================================================

# Public base URL of this app (used to build the OAuth redirect + post-login bounce).
# For local dev this is typically http://localhost:5500
APP_BASE_URL="http://localhost:5500"

# Instagram App credentials (from the Meta/Facebook developer dashboard)
IG_OAUTH_CLIENT_ID=""
IG_OAUTH_CLIENT_SECRET=""

# Where Instagram sends the user back after consent. Must be whitelisted in the app.
# Defaults to <APP_BASE_URL>/api/auth/instagram/oauth/callback when left blank.
IG_OAUTH_REDIRECT_URI=""

# Space/comma separated OAuth scopes. Default is read-only business basics.
# e.g. "instagram_business_basic,instagram_business_content_publish"
IG_OAUTH_SCOPES="instagram_business_basic"

# ==============================================================================
# OPTION 2 — Manual session paste
# ------------------------------------------------------------------------------
# No env config required. In the Connect dialog, a user may paste THEIR OWN
# Instagram `sessionid` (copied from their own browser) to link the account.
# The value is encrypted at rest (AES-256-GCM) using APP_SECRET.
# NOTE: reusing a session cookie this way is unofficial, violates Instagram's
# Terms of Service, and can get the account challenged or banned. The UI warns
# the user before they submit. Prefer OPTION 1 for anything shared or public.
# ==============================================================================
