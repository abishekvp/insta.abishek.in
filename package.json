{
  "name": "insta-vault-pro",
  "version": "1.0.0",
  "description": "Professional Instagram Story Saver, 30-day TTL Archiver, and Intelligence Suite",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "make:admin": "tsx scripts/make-admin.ts",
    "session:fetch": "tsx scripts/fetch-session.ts",
    "test:connect": "tsx scripts/test-connect.ts",
    "set:password": "tsx scripts/set-password.ts",
    "password:set": "tsx scripts/set-password.ts"
  },
  "keywords": [
    "instagram",
    "story-saver",
    "follower-tracker",
    "unfollower-detector",
    "monolith"
  ],
  "author": "Abishek V",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
